# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# O ".env" não deve ser commitado (já está no .gitignore).

# --- Banco de dados ---
DB_URL=jdbc:mysql://mysql:3306/desbravadores_db?useTimezone=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
MYSQL_DATABASE=desbravadores_db
# Em produção, defina uma senha de root e configure DB_PASSWORD com o mesmo valor.
MYSQL_ALLOW_EMPTY_PASSWORD=yes

# --- JWT ---
# OBRIGATÓRIO em produção: gere uma chave aleatória com pelo menos 32 caracteres
# (ex.: openssl rand -base64 48). O valor abaixo é só para desenvolvimento.
JWT_SECRET=dev-only-insecure-secret-change-me-in-prod-1234
# Tempo de expiração do token em milissegundos. Padrão: 8 horas.
JWT_EXPIRATION_MS=28800000

# --- Administrador padrão (criado automaticamente se não existir) ---
ADMIN_EMAIL=adm@gmail.com
ADMIN_PASSWORD=adm123

# --- CORS ---
# Origens do frontend permitidas a chamar a API (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
